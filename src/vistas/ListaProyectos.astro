---
import Base from '../layouts/Base.astro';
import Seccion from '../components/Seccion.astro';
import TarjetaProyecto from '../components/TarjetaProyecto.astro';
import { cargarProyectos } from '../i18n/proyectos';
import { textos } from '../i18n/textos';
import type { Idioma } from '../i18n/rutas';

// Todos, por `orden`. Con página propia ya no hace falta recortar a la
// parrilla 2×2 que imponía la portada.
interface Props { lang: Idioma }
const { lang } = Astro.props;
const t = textos[lang].proyectos;
const proyectos = await cargarProyectos(lang);
---

<Base titulo={t.titulo} descripcion={t.descripcion}>
  <section class="bloque contenedor">
    <Seccion titulo={t.titulo} id="proyectos" nivel={1} />
    <div class="parrilla-proyectos">
      {proyectos.map((p) => <TarjetaProyecto proyecto={p.proyecto} datos={p.datos} lang={lang} />)}
    </div>
  </section>
</Base>

<style>
  .bloque { padding-block: clamp(48px, 7vw, 88px) var(--aire); }

  .parrilla-proyectos {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 28px;
    margin-top: 40px;
  }
  @media (max-width: 780px) {
    .parrilla-proyectos { grid-template-columns: 1fr; gap: 16px; }
  }
</style>
