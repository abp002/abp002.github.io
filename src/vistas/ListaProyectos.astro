---
import Base from '../layouts/Base.astro';
import Icono from '../components/Icono.astro';
import Muestra from '../components/Muestra.astro';
import { cargarProyectos } from '../i18n/proyectos';
import { textos } from '../i18n/textos';
import { rutaProyecto, type Idioma } from '../i18n/rutas';

// El índice de proyectos: todos al mismo nivel, sin número ni estado que
// los ponga en fila; `orden` solo decide dónde cae cada uno. Cada proyecto
// se ve antes de leerse, con su muestra encima, y cada tarjeta es un
// enlace entero a su ficha.
interface Props { lang: Idioma }
const { lang } = Astro.props;
const t = textos[lang].proyectos;
const proyectos = await cargarProyectos(lang);

const anios = proyectos.map((p) => p.datos.anio);
const desde = Math.min(...anios);
const hasta = Math.max(...anios);
const periodo = desde === hasta ? `${desde}` : `${desde} — ${hasta}`;
---

<Base titulo={t.titulo}>
  <section class="indice contenedor" aria-labelledby="proyectos-titulo">
    <header class="cabecera">
      <div class="rotulo">
        <p class="dato meta">
          <span class="acento">{t.indice}</span>
          <span>{t.cuantos(proyectos.length)}</span>
          <span>{periodo}</span>
        </p>
        <h1 id="proyectos-titulo" class="titulo">{t.titulo}</h1>
      </div>
    </header>

    <ul class="lista" role="list">
      {proyectos.map((p) => (
        <li class="revela">
          <a class="enlace-fila tarjeta" href={rutaProyecto(lang, p.proyecto.id)}>
            <Muestra datos={p.datos} />
            <div class="texto">
              <div class="cabeza">
                <h2 class="nombre titulo-fila" transition:name={`titulo-${p.proyecto.id}`}>{p.datos.nombre}</h2>
                <span class="flecha"><Icono nombre="flecha" tamano={20} /></span>
              </div>
              <p class="tagline">{p.datos.tagline}</p>
              <p class="stack">{p.datos.stack.join(' · ')}</p>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .indice { padding-top: clamp(48px, 7vw, 88px); }

  .cabecera {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 22px 72px;
    border-top: 1px solid var(--linea-fuerte);
    padding-top: 22px;
  }
  .rotulo {
    flex: 1 1 360px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .meta { display: flex; flex-wrap: wrap; gap: 6px 14px; }
  .titulo {
    font-family: var(--serif);
    font-size: clamp(40px, 5vw, 68px);
    line-height: 1.02;
    letter-spacing: -0.028em;
  }
  /* Dos columnas en cuanto caben dos tarjetas de 340 px; una en móvil. */
  .lista {
    list-style: none;
    margin: clamp(40px, 5vw, 64px) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
    gap: clamp(44px, 6vw, 64px) clamp(28px, 4vw, 44px);
  }

  /* Cada entrada abre con su filete, como las secciones del cuaderno. */
  .tarjeta {
    display: flex;
    flex-direction: column;
    gap: 22px;
    height: 100%;
    padding-top: 22px;
    border-top: 1px solid var(--linea);
  }
  .texto {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .cabeza {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 20px;
  }
  .nombre {
    font-family: var(--serif);
    font-size: clamp(24px, 2.4vw, 30px);
    line-height: 1.15;
    letter-spacing: -0.015em;
  }
  .flecha { flex: 0 0 auto; margin-top: 6px; }
  .tagline {
    max-width: 680px;
    font-size: 15.5px;
    line-height: 1.55;
    color: var(--sec);
    text-wrap: pretty;
  }
  .stack {
    font-family: var(--mono);
    font-size: 12.5px;
    line-height: 1.6;
    color: var(--sec);
  }
</style>
