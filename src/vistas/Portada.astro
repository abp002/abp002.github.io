---
import Base from '../layouts/Base.astro';
import Intro from '../components/Intro.astro';
import Seccion from '../components/Seccion.astro';
import Cronologia from '../components/Cronologia.astro';
import OpenSource from '../components/OpenSource.astro';
import Stack from '../components/Stack.astro';
import Contacto from '../components/Contacto.astro';
import { experiencia, formacion } from '../config/trayectoria';
import { textos } from '../i18n/textos';
import type { Idioma } from '../i18n/rutas';

// La portada en cualquier idioma; /index.astro y /en/index.astro solo
// eligen cuál. Es quién soy y cómo escribirme: proyectos y blog tienen
// página propia y no se repiten aquí.
interface Props { lang: Idioma }
const { lang } = Astro.props;
const t = textos[lang];
const s = t.secciones;

const trabajos = experiencia[lang].map((e) => ({
  entidad: e.empresa,
  periodo: e.periodo,
  titulo: e.cargo,
  puntos: e.puntos,
}));
const estudios = formacion[lang].map((f) => ({
  entidad: f.centro,
  periodo: f.periodo,
  titulo: f.titulo,
}));
---

<Base descripcion={t.meta.subtitulo}>
  <Intro lang={lang} />

  <section class="bloque contenedor" aria-label={s.trayectoria.titulo}>
    <Seccion numero="01" titulo={s.trayectoria.titulo} id={s.trayectoria.id} />
    <Cronologia hitos={trabajos} />
  </section>

  <section class="bloque contenedor" aria-label={s.formacion.titulo}>
    <Seccion numero="02" titulo={s.formacion.titulo} id={s.formacion.id} />
    <Cronologia hitos={estudios} compacta />
  </section>

  <section class="bloque contenedor" aria-label={s.openSource.titulo}>
    <Seccion numero="03" titulo={s.openSource.titulo} id={s.openSource.id} />
    <p class="entradilla revela">{t.openSource.intro}</p>
    <OpenSource lang={lang} />
  </section>

  <section class="bloque contenedor" aria-label={s.stack.titulo}>
    <Seccion numero="04" titulo={s.stack.titulo} id={s.stack.id} />
    <Stack lang={lang} />
  </section>

  <Contacto lang={lang} />
</Base>

<style>
  .bloque { padding-top: var(--hueco); }

  .entradilla {
    margin-top: 22px;
    max-width: 680px;
    font-family: var(--serif);
    font-size: 19px;
    line-height: 1.7;
    color: var(--prosa);
    text-wrap: pretty;
  }
</style>
