---
import Base from '../layouts/Base.astro';
import Icono from '../components/Icono.astro';
import { numero, type ProyectoLocal } from '../i18n/proyectos';
import { textos } from '../i18n/textos';
import { rutaProyecto, rutaProyectos, type Idioma } from '../i18n/rutas';
import { partirFicha } from '../lib/partes';

// La ficha en cualquier idioma. Las rutas (/proyectos/[slug] y
// /en/projects/[slug]) generan los paths y le pasan el proyecto ya
// resuelto en su idioma.
interface Props {
  lang: Idioma;
  actual: ProyectoLocal;
  siguiente: ProyectoLocal;
}
const { lang, actual, siguiente } = Astro.props;
const { proyecto } = actual;
const d = actual.datos;
const t = textos[lang].ficha;
const n = textos[lang].proyectos.numero;

// La barrera contra publicar trabajo del empleador: si la ficha está
// marcada sin detalle, no se pintan ni vídeo ni enlaces. Lo decide el
// dato, no que yo me acuerde al escribir el componente. Viene siempre de
// la ficha española: la inglesa no puede abrirla.
const conDetalle = d.visibilidad === 'publico';

const secciones = partirFicha(actual.cuerpo.rendered?.html ?? '');

interface Accion { texto: string; href: string; fuera: boolean }
// Las acciones de la cabecera, en este orden: la primera lleva el borde en
// tinta y las demás, el suave.
const acciones: Accion[] = conDetalle
  ? [
      d.enlaces?.repo ? { texto: t.verCodigo, href: d.enlaces.repo, fuera: true } : null,
      d.enlaces?.web ? { texto: t.verWeb, href: d.enlaces.web, fuera: true } : null,
      d.enlaces?.demo ? { texto: t.probarDemo, href: d.enlaces.demo, fuera: true } : null,
      d.video ? { texto: t.verDemo, href: '#demo', fuera: false } : null,
    ].filter((a): a is Accion => a !== null)
  : [];

// La URL a la vista, sin protocolo y en trozos por cada «/»: Chrome no
// corta una URL por la barra, y en los 126 px de la ficha lateral
// github.com/abp002/sello se partía a mitad de «abp002». Con un <wbr> tras
// cada barra corta donde se lee bien.
const trozosUrl = (url: string) => url.replace(/^https?:\/\//, '').replace(/\/$/, '').split('/');
---

<Base titulo={d.nombre} descripcion={d.tagline}>
  <article>
    <section class="cabecera contenedor">
      <a class="volver dato" href={rutaProyectos(lang)}>← {t.volver}</a>

      <div class="fila">
        <div class="rotulo">
          <p class="dato meta">
            <span class="acento">{t.proyecto}</span>
            <span>{n} {numero(actual.numero)}</span>
            <span>{d.anio}</span>
          </p>
          <h1 class="titulo" transition:name={`titulo-${proyecto.id}`}>{d.nombre}</h1>
          <p class="tagline">{d.tagline}</p>
          {acciones.length > 0 && (
            <div class="acciones">
              {acciones.map((a, i) => (
                <a
                  href={a.href}
                  class:list={['boton', { 'boton-suave': i > 0 }]}
                  rel={a.fuera ? 'noopener' : undefined}
                  target={a.fuera ? '_blank' : undefined}
                >
                  {a.texto}
                  {a.fuera && <Icono nombre="flecha" tamano={16} />}
                </a>
              ))}
            </div>
          )}
        </div>

        <aside class="ficha-lateral" aria-label={t.fichaEtiqueta}>
          <dl>
            <div>
              <dt class="dato">{t.estado}</dt>
              <dd class="estado">
                <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true">
                  <circle cx="5" cy="5" r="4" fill="none" stroke="currentColor" stroke-width="1.6" />
                  <circle cx="5" cy="5" r="1.6" fill="currentColor" />
                </svg>
                <span>{d.fase ?? textos[lang].estados[d.estado]}</span>
              </dd>
            </div>
            {d.metrica && (
              <div class="ancho">
                <dt class="dato">{t.resultado}</dt>
                <dd><span class="cifra">{d.metrica.valor}</span> {d.metrica.que}</dd>
              </div>
            )}
            {conDetalle && d.enlaces?.repo && (
              <div>
                <dt class="dato">{t.codigo}</dt>
                <dd class="mono prosa">
                  <a href={d.enlaces.repo} rel="noopener" target="_blank">
                    {trozosUrl(d.enlaces.repo).map((trozo, i) => (i === 0 ? trozo : <>/<wbr />{trozo}</>))}
                  </a>
                </dd>
              </div>
            )}
            {conDetalle && d.enlaces?.web && (
              <div>
                <dt class="dato">{t.web}</dt>
                <dd class="mono prosa">
                  <a href={d.enlaces.web} rel="noopener" target="_blank">
                    {trozosUrl(d.enlaces.web).map((trozo, i) => (i === 0 ? trozo : <>/<wbr />{trozo}</>))}
                  </a>
                </dd>
              </div>
            )}
          </dl>
        </aside>
      </div>
    </section>

    {conDetalle && d.video && (
      <section class="figura contenedor">
        <figure id="demo">
          {d.video.startsWith('/') ? (
            <video
              class="video"
              src={d.video}
              poster={d.portada?.imagen}
              controls
              preload="none"
              playsinline
              title={`${t.video} ${d.nombre}`}
            />
          ) : (
          <iframe
            class="video"
            src={`https://www.youtube-nocookie.com/embed/${d.video}`}
            title={`${t.video} ${d.nombre}`}
            loading="lazy"
            allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            referrerpolicy="strict-origin-when-cross-origin"
            allowfullscreen
          ></iframe>
          )}
          {d.pieVideo && (
            <figcaption>
              <span class="dato acento">{t.figura} 1</span>
              {d.pieVideo}
            </figcaption>
          )}
        </figure>
      </section>
    )}

    <section class="secciones contenedor">
      {secciones.map((sec) => (
        <section class="seccion revela">
          {sec.titulo && <h2 class="dato acento">{sec.titulo}</h2>}
          <div class="prosa cuerpo"><Fragment set:html={sec.html} /></div>
        </section>
      ))}
      {d.borrador && <p class="aviso">{t.borrador}</p>}
    </section>

    <nav class="mas contenedor" aria-label={t.masProyectos}>
      <a class="enlace-fila indice" href={rutaProyectos(lang)}>
        <span class="dato">← {t.indice}</span>
        <span class="titulo-fila nombre">{t.todos}</span>
      </a>
      <a class="enlace-fila siguiente" href={rutaProyecto(lang, siguiente.proyecto.id)}>
        <span class="dato acento">{t.siguiente} · {n} {numero(siguiente.numero)}</span>
        <span class="titulo-fila nombre">{siguiente.datos.nombre}</span>
        <span class="resumen">{siguiente.datos.tagline}</span>
      </a>
    </nav>
  </article>
</Base>

<style>
  /* --- cabecera --- */
  .cabecera { padding-top: clamp(40px, 6vw, 72px); }

  .volver {
    display: inline-flex;
    padding-block: 12px;
    margin-block: -12px;
    text-decoration: none;
    transition: color var(--t-micro) var(--ease-salida);
  }
  .volver:hover { color: var(--tinta); }

  /* La ficha va debajo del rótulo, en una franja a todo el ancho: al lado
     era una columna estrecha que partía cada dato en cinco líneas y
     alargaba la cabecera entera. */
  .fila {
    margin-top: 28px;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }
  .rotulo {
    min-width: 0;
    max-width: 680px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 14px;
    font-size: 12px;
    letter-spacing: 0.1em;
  }
  .titulo {
    font-family: var(--serif);
    font-size: clamp(40px, 5.4vw, 72px);
    line-height: 1.02;
    letter-spacing: -0.03em;
  }
  .tagline {
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(20px, 2vw, 26px);
    line-height: 1.35;
    color: var(--sec);
    text-wrap: pretty;
  }
  .acciones { margin-top: 10px; display: flex; flex-wrap: wrap; gap: 12px; }

  .ficha-lateral {
    border-block: 1px solid var(--linea);
  }
  dl {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0 32px;
  }
  dl > div {
    flex: 1 1 180px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding-block: 16px;
  }
  /* El resultado es la frase más larga: se lleva más ancho. */
  dl > div.ancho { flex: 2 1 260px; }
  dd {
    min-width: 0;
    margin: 0;
    font-size: 15px;
    line-height: 1.45;
    color: var(--tinta);
  }
  /* break-word solo como red: los cortes buenos de una URL los ponen los
     <wbr> tras cada barra. */
  dd.mono {
    font-family: var(--mono);
    font-size: 13px;
    line-height: 1.7;
    overflow-wrap: break-word;
  }
  .estado { display: flex; align-items: baseline; gap: 8px; }
  .estado svg { flex: 0 0 auto; color: var(--acento); }
  .cifra {
    font-family: var(--mono);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    color: var(--acento);
  }

  /* --- figura --- */
  .figura { padding-top: clamp(48px, 6vw, 72px); }
  figure { margin: 0; display: flex; flex-direction: column; gap: 14px; }
  .video {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 1px solid var(--linea);
    border-radius: 4px;
    background: var(--tinta);
  }
  figcaption {
    max-width: 760px;
    font-size: 14px;
    line-height: 1.55;
    color: var(--sec);
    text-wrap: pretty;
  }
  figcaption .dato { margin-right: 10px; }

  /* --- cuerpo: Resumen, Stack, Arquitectura y Observaciones --- */
  /* Cada sección es una fila: el rótulo a la izquierda y el texto en una
     columna de lectura. En móvil el rótulo sube encima. */
  .secciones { padding-top: clamp(48px, 6vw, 72px); }
  .seccion {
    display: grid;
    grid-template-columns: 180px minmax(0, 680px);
    column-gap: 56px;
    padding-block: 28px;
    border-top: 1px solid var(--linea);
  }
  .seccion:first-child { border-top: 2px solid var(--tinta); }
  .seccion h2 { padding-top: 6px; font-size: 12px; }
  @media (max-width: 880px) {
    .seccion { grid-template-columns: minmax(0, 1fr); row-gap: 12px; }
  }

  .cuerpo :global(p),
  .cuerpo :global(li) {
    font-family: var(--serif);
    font-size: 19px;
    line-height: 1.7;
    color: var(--prosa);
    text-wrap: pretty;
  }
  .cuerpo :global(* + *) { margin-top: 16px; }
  /* La primera sección es el resumen: entra un punto más grande. */
  .seccion:first-child .cuerpo :global(p) { font-size: clamp(20px, 1.7vw, 22px); line-height: 1.6; }

  /* Una lista sin numerar es el stack o las observaciones: filete entre
     una línea y otra, y la pieza en negrita pasa a monoespaciada. */
  .cuerpo :global(ul),
  .cuerpo :global(ol) { list-style: none; margin: 0; padding: 0; }
  .cuerpo :global(li) { position: relative; margin: 0; padding-block: 10px; line-height: 1.55; }
  .cuerpo :global(li + li) { border-top: 1px solid var(--linea); }
  .cuerpo :global(ul > li > strong:first-child) {
    font-family: var(--mono);
    font-size: 15px;
    font-weight: 500;
    color: var(--tinta);
  }
  /* Una lista numerada es la arquitectura: un paso por línea, con su
     número en óxido. */
  .cuerpo :global(ol) { counter-reset: paso; }
  .cuerpo :global(ol > li) { padding-left: 40px; counter-increment: paso; }
  .cuerpo :global(ol > li::before) {
    content: counter(paso, decimal-leading-zero);
    position: absolute;
    left: 0;
    top: 10px;
    font-family: var(--mono);
    font-size: 13px;
    line-height: 2.2;
    color: var(--acento);
  }
  .cuerpo :global(ol > li > strong:first-child) { color: var(--tinta); }

  .secciones .aviso {
    margin-top: 36px;
    max-width: 680px;
    padding-top: 12px;
    border-top: 1px solid var(--linea);
    font-size: 15px;
    line-height: 1.55;
    color: var(--sec);
  }

  /* --- más proyectos --- */
  .mas {
    padding-top: clamp(72px, 9vw, 112px);
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 36px 56px;
  }
  .mas a { display: flex; flex-direction: column; gap: 8px; padding-top: 16px; }
  .indice { flex: 1 1 280px; min-width: 0; border-top: 1px solid var(--linea-fuerte); }
  .siguiente { flex: 999 1 420px; min-width: 0; border-top: 2px solid var(--tinta); }
  .nombre {
    font-family: var(--serif);
    font-size: 22px;
    line-height: 1.25;
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  .resumen { font-size: 14.5px; line-height: 1.55; color: var(--sec); text-wrap: pretty; }
</style>
