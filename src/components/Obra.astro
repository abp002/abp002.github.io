---
import Miniatura from './Miniatura.astro';
import type { CollectionEntry } from 'astro:content';

interface Props { proyecto: CollectionEntry<'proyectos'> }
const { proyecto } = Astro.props;
const d = proyecto.data;
const url = `/proyectos/${proyecto.id}`;
---

<article class="obra">
  <a href={url} class="marco revela" aria-label={`Ver ${d.nombre}`}>
    <Miniatura patron={d.patron} nombre={d.nombre} transitionName={`obra-${proyecto.id}`} />
  </a>

  <div class="cartela revela-tarde">
    <h3 class="titulo-obra">
      <a href={url} transition:name={`titulo-${proyecto.id}`}>{d.nombre}</a>
    </h3>

    <div class="datos">
      <span class="estado">{d.estado.replace('-', ' ')}</span>
      <span class="dato">{d.anio}</span>
      {d.metrica && <span class="cifra">{d.metrica.valor}</span>}
    </div>

    <p class="tagline">{d.tagline}</p>
  </div>
</article>

<style>
  .obra {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: clamp(24px, 4vw, 52px);
    align-items: center;
  }
  /* Alternar el lado evita que la sala se lea como una lista. */
  .obra:nth-child(even) .marco { order: 2; }

  @media (max-width: 720px) {
    .obra { grid-template-columns: 1fr; gap: 20px; }
    .obra:nth-child(even) .marco { order: 0; }
  }

  .marco {
    display: block;
    overflow: hidden;
    border-radius: 2px;
    transition: transform var(--t-micro) var(--ease-salida);
  }
  .marco :global(.miniatura) {
    transition: scale var(--t-hover) var(--ease-mov);
  }
  /* Acercarse a la obra. Detrás de hover fino: en táctil un toque no
     debe disparar un estado que solo existe para el ratón. */
  @media (hover: hover) and (pointer: fine) {
    .marco:hover :global(.miniatura) { scale: 1.03; }
  }
  .marco:active { transform: scale(0.99); }

  .cartela {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .titulo-obra a { text-decoration: none; }

  .datos {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--grafito);
  }
  .estado {
    border: 1px solid var(--linea);
    border-radius: 2px;
    padding: 2px 7px;
    white-space: nowrap;
  }
  /* Las unidades son minúsculas: "8,85 s", nunca "8,85 S". La versalita
     de la fila no debe tocar una magnitud física. */
  .datos .cifra {
    text-transform: none;
    letter-spacing: 0.02em;
    font-size: 12.5px;
  }

  .tagline {
    color: var(--grafito);
    max-width: 42ch;
  }

  @media (prefers-reduced-motion: reduce) {
    .marco, .marco :global(.miniatura) { transition: none; }
    .marco:hover :global(.miniatura) { scale: 1; }
  }
</style>
