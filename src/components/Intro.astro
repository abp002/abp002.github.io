---
import { textos } from '../i18n/textos';
import { rutaProyectos, type Idioma } from '../i18n/rutas';

// La apertura del cuaderno: el cargo a 30 px, dónde y dos párrafos. Sin
// titular de cartel ni botones: los enlaces ya están en la barra.
interface Props { lang: Idioma }
const { lang } = Astro.props;
const t = textos[lang];

const destinos = {
  proyectos: rutaProyectos(lang),
  openSource: `#${t.secciones.openSource.id}`,
};
---

<section class="intro contenedor" aria-labelledby="intro-titulo">
  <div class="columna entrada">
    <h1 id="intro-titulo" class="titulo">
      {t.intro.titulo.antes}<span class="unido">{t.intro.titulo.unido}</span>{t.intro.titulo.despues}
    </h1>
    <p class="dato lugar">{t.intro.ubicacion}</p>
    <div class="prosa texto">
      {t.intro.parrafos.map((parrafo) => (
        <p>
          {parrafo.map((trozo) =>
            typeof trozo === 'string' ? trozo : <a href={destinos[trozo.a]}>{trozo.texto}</a>,
          )}
        </p>
      ))}
    </div>
  </div>
</section>

<style>
  .intro { padding-top: clamp(48px, 7vw, 80px); }
  .columna { max-width: 680px; }

  .titulo {
    font-family: var(--serif);
    font-size: 30px;
    line-height: 1.2;
    letter-spacing: -0.015em;
  }
  /* El navegador puede partir después del guion duro y dejar «full-» al
     final de la línea. nowrap y no U+2011: el h1 sigue diciendo
     literalmente «full-stack». */
  .unido { white-space: nowrap; }

  .lugar { margin-top: 10px; }

  .texto {
    margin-top: 28px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    font-family: var(--serif);
    font-size: 19px;
    line-height: 1.7;
    color: var(--prosa);
    text-wrap: pretty;
  }
</style>
