---
import { marca, perfil, contacto } from '../config/marca';
import Icono from './Icono.astro';

const github = contacto.find((c) => c.etiqueta === 'GitHub');
const linkedin = contacto.find((c) => c.etiqueta === 'LinkedIn');
---

<div class="cierre revela">
  <p class="invitacion">¿Encajo en tu equipo? <em>Escríbeme.</em></p>

  <a href={`mailto:${marca.correo}`} class="correo">{marca.correo}</a>

  <div class="acciones">
    {perfil.cv && (
      <a href={perfil.cv} class="btn btn-primario" download>
        <Icono nombre="descarga" tamano={15} />
        Descargar CV (PDF)
      </a>
    )}
    {github?.href && (
      <a href={github.href} class="btn btn-borde">
        <Icono nombre="github" tamano={15} />
        GitHub — {github.valor}
      </a>
    )}
    {linkedin?.href && (
      <a href={linkedin.href} class="btn btn-borde">
        <Icono nombre="linkedin" tamano={15} />
        LinkedIn
      </a>
    )}
  </div>
</div>

<style>
  .cierre {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 34px;
    margin-top: 48px;
  }

  .invitacion {
    font-family: var(--serif);
    font-size: clamp(30px, 4.4vw, 44px);
    line-height: 1.2;
    font-weight: 500;
    letter-spacing: -0.015em;
    max-width: 760px;
  }
  .invitacion em { font-style: italic; }

  .correo {
    font-family: var(--mono);
    font-size: clamp(17px, 3vw, 28px);
    font-weight: 500;
    text-decoration: none;
    border-bottom: 2px solid var(--acento);
    padding-bottom: 8px;
    overflow-wrap: anywhere;
  }

  .acciones { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 8px; }

  @media (max-width: 680px) {
    .acciones { width: 100%; }
    .acciones .btn { width: 100%; justify-content: center; }
  }
</style>
