---
import { marca, perfil } from '../config/marca';
import Icono from './Icono.astro';
import { textos } from '../i18n/textos';
import type { Idioma } from '../i18n/rutas';

// El cierre de la portada: sin número, con filete de 2 px en tinta. La
// pregunta a la izquierda y la vía a la derecha; el correo escrito entero,
// que es lo que se copia.
interface Props { lang: Idioma }
const { lang } = Astro.props;
const t = textos[lang];
---

<section id={t.secciones.contacto.id} class="contacto contenedor" aria-labelledby="contacto-titulo">
  <div class="marco revela">
    <div class="rotulo">
      <p class="dato acento">{t.secciones.contacto.titulo}</p>
      <h2 id="contacto-titulo" class="pregunta">{t.contacto.pregunta}</h2>
    </div>
    <div class="vias">
      <p class="prosa correo">
        {t.contacto.escribeme} <a href={`mailto:${marca.correo}`}>{marca.correo}</a>.
      </p>
      <p class="perfil">{t.contacto.perfil}</p>
      {perfil.cv && (
        <a href={perfil.cv} class="boton cv" download>
          <Icono nombre="descarga" tamano={15} />
          {t.contacto.cv}
        </a>
      )}
    </div>
  </div>
</section>

<style>
  .contacto { padding-top: clamp(72px, 9vw, 112px); }

  .marco {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 20px 56px;
    border-top: 2px solid var(--tinta);
    padding-top: 22px;
  }

  .rotulo {
    flex: 1 1 300px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .pregunta {
    font-family: var(--serif);
    font-size: clamp(34px, 3.6vw, 48px);
    line-height: 1.04;
    letter-spacing: -0.025em;
  }

  .vias {
    flex: 999 1 480px;
    min-width: 0;
    max-width: 620px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
  }
  .correo {
    font-family: var(--serif);
    font-size: clamp(19px, 1.6vw, 22px);
    line-height: 1.5;
    color: var(--prosa);
    overflow-wrap: anywhere;
  }
  .perfil { font-size: 15.5px; line-height: 1.55; color: var(--sec); }
  .cv { margin-top: 12px; }
</style>
