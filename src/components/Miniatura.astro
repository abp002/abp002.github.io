---
// Marcadores visuales hasta que haya fotografía y vídeo reales.
// Son CSS, no imágenes: pesan cero y no hay que mantener assets que
// van a sustituirse en cuanto Alejandro grabe el material.
interface Props {
  patron: 'spartan' | 'sello' | 'arkon' | 'kuro' | 'dental';
  nombre: string;
  transitionName?: string;
  etiqueta?: string;
}
const { patron, nombre, transitionName, etiqueta = 'Imagen de' } = Astro.props;
---

<div
  class:list={['miniatura', `p-${patron}`]}
  role="img"
  aria-label={`${etiqueta} ${nombre}`}
  transition:name={transitionName}
>
</div>

<style>
  .miniatura {
    aspect-ratio: 4 / 3;
    width: 100%;
    border-radius: 2px;
    background-color: var(--tinta);
  }

  /* Spartan Comunica: la rejilla del calendario con publicaciones ya
     colocadas, que es lo que el producto vende. */
  .p-spartan {
    /* 7 columnas × 4 filas. Con tamaño w, la posición p% deja el borde en
       p·(1−w): columna c → c/6, y cada post ocupa el 12 % de alto. */
    --post: calc(100% / 7) 12%;
    background-image:
      linear-gradient(90deg, transparent 8%, #C8442B 8% 92%, transparent 92%),
      linear-gradient(90deg, transparent 8%, #E9E4D8 8% 92%, transparent 92%),
      linear-gradient(90deg, transparent 8%, #8FA3BF 8% 92%, transparent 92%),
      linear-gradient(90deg, transparent 8%, #C8442B 8% 92%, transparent 92%),
      linear-gradient(90deg, rgba(255,255,255,.14) 1px, transparent 1px),
      linear-gradient(0deg, rgba(255,255,255,.14) 1px, transparent 1px),
      linear-gradient(160deg, #22252C, #121317);
    background-size: var(--post), var(--post), var(--post), var(--post),
      calc(100% / 7) 25%, calc(100% / 7) 25%, auto;
    background-position: 16.67% 35.8%, 66.67% 64.2%, 50% 92.6%, 83.33% 7.4%,
      0 0, 0 0, 0 0;
    background-repeat: no-repeat, no-repeat, no-repeat, no-repeat, repeat, repeat, no-repeat;
  }
  /* Sello: el sello sobre el papel, la marca que certifica. */
  .p-sello {
    background-image:
      radial-gradient(circle at 50% 50%, transparent 0 13%, #C8442B 13.5% 15%, transparent 15.5%),
      radial-gradient(circle at 50% 50%, transparent 0 17%, #C8442B 17.5% 18.3%, transparent 18.8%),
      repeating-linear-gradient(0deg, rgba(20,20,24,.10) 0 1px, transparent 1px 18px),
      linear-gradient(170deg, #EFEBE1, #E2DCCD);
  }
  .p-arkon {
    background-image:
      repeating-linear-gradient(0deg, rgba(255,255,255,.13) 0 1px, transparent 1px 22px),
      repeating-linear-gradient(90deg, rgba(255,255,255,.13) 0 1px, transparent 1px 22px),
      linear-gradient(150deg, #1D2340, #0B1020);
  }
  /* Dental Vision: las dos arcadas sobre el negro de la placa, 32 piezas
     cortadas por una máscara cónica (11,25° cada una) y separadas por la
     línea de oclusión. */
  .p-dental {
    position: relative;
    background-image: radial-gradient(ellipse at 50% 50%, #2B2D33, #0C0D10 72%);
  }
  .p-dental::after {
    content: '';
    position: absolute;
    inset: 16% 12%;
    background: radial-gradient(ellipse 50% 50% at 50% 50%,
      transparent 0 64%, #DAD5C8 65% 82%, transparent 83%);
    mask:
      repeating-conic-gradient(from 1deg at 50% 50%, #000 0 9.25deg, transparent 9.25deg 11.25deg),
      linear-gradient(#000 0 47%, transparent 47% 53%, #000 53%);
    mask-composite: intersect;
  }
  .p-kuro {
    background-color: #08080A;
    display: grid;
    place-items: center;
  }
  .p-kuro::after {
    content: '黒';
    color: #E8E8E8;
    font-size: clamp(38px, 7vw, 76px);
    line-height: 1;
  }
</style>
