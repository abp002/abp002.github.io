---
// Cabecera de sección del expediente: regla fuerte, número en acento,
// título en serif. El número es parte de la retórica de la página
// (documento numerado), no decoración.
// En la portada numera el expediente; en una página propia (/proyectos,
// /blog) es el h1 y va sin número, porque fuera de la portada no hay
// secuencia que contar.
interface Props {
  numero?: string;
  titulo: string;
  id: string;
  nivel?: 1 | 2;
}
const { numero, titulo, id, nivel = 2 } = Astro.props;
const Titulo = nivel === 1 ? 'h1' : 'h2';
---

<div class="cabecera" id={id}>
  {numero && <span class="numero" aria-hidden="true">{numero}</span>}
  <Titulo class="titulo">{titulo}</Titulo>
</div>

<style>
  .cabecera {
    display: flex;
    align-items: baseline;
    gap: 18px;
    border-top: 1px solid var(--linea-fuerte);
    padding-top: 18px;
  }
  .numero {
    font-family: var(--mono);
    font-size: 13px;
    color: var(--acento);
    font-variant-numeric: tabular-nums;
  }
  .titulo {
    font-family: var(--serif);
    font-size: 24px;
    font-weight: 500;
    letter-spacing: -0.01em;
  }
</style>
