---
// Cabecera de sección del expediente: regla fuerte, número en acento,
// título en serif. El número es parte de la retórica de la página
// (documento numerado), no decoración.
interface Props {
  numero: string;
  titulo: string;
  id: string;
}
const { numero, titulo, id } = Astro.props;
---

<div class="cabecera" id={id}>
  <span class="numero" aria-hidden="true">{numero}</span>
  <h2 class="titulo">{titulo}</h2>
</div>

<style>
  .cabecera {
    display: flex;
    align-items: baseline;
    gap: 18px;
    border-top: 1px solid var(--linea-fuerte);
    padding-top: 18px;
  }
  .numero {
    font-family: var(--mono);
    font-size: 13px;
    color: var(--acento);
    font-variant-numeric: tabular-nums;
  }
  .titulo {
    font-family: var(--serif);
    font-size: 24px;
    font-weight: 500;
    letter-spacing: -0.01em;
  }
</style>
