---
import { marca, perfil } from '../config/marca';

// Las señales que un reclutador busca antes de leer nada. `perfil.rol` NO
// entra: desde que el titular es el propio cargo, repetirlo aquí abajo sería
// decir lo mismo dos veces con dos tamaños distintos.
//
// Se filtran los `null` en vez de escribir texto de relleno, para que un dato
// que falta desaparezca de la página en lugar de publicarse a medias.
const señales = [
  perfil.experiencia,
  perfil.ubicacion,
  perfil.disponibilidad,
].filter((s): s is string => Boolean(s));

// Composición del titular. A 62 px cada salto de línea se ve, así que hay dos
// que hay que impedir:
//
//   'full-stack' — lleva un guion real y el navegador corta después de él
//     ("Desarrollador full-" / "stack e IA aplicada"). `hyphens: manual` no lo
//     evita: no es división silábica, es una oportunidad de salto legítima.
//   'e IA' — una conjunción de una letra colgando al final de la línea.
//
// Se marcan con nowrap en vez de escribir guiones y espacios no separables
// (U+2011, U+00A0) para que el texto siga siendo literalmente "full-stack":
// es un término que la gente busca tal cual, y en un h1 eso importa.
const inseparables = ['full-stack', 'e IA'];
const titular = inseparables.reduce(
  (texto, frag) => texto.replace(frag, `<span class="junto">${frag}</span>`),
  marca.declaracion,
);
---

<section class="apertura contenedor entrada">
  <h1 class="display" set:html={titular} />

  {señales.length > 0 && (
    <ul class="señales">
      {señales.map((s) => <li class="dato">{s}</li>)}
    </ul>
  )}

  <div class="acciones">
    <a href="#trabajo" class="boton primario">Ver el trabajo</a>
    <a href={`mailto:${marca.correo}`} class="boton">Escríbeme</a>
    {perfil.cv && <a href={perfil.cv} class="boton" download>Descargar CV</a>}
  </div>
</section>

<style>
  .apertura {
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding-block: clamp(56px, 12vw, 128px) var(--aire);
  }
  /* 15ch parte el titular en tres líneas ("Desarrollador / full-stack /
     e IA aplicada."). Dejarlo correr a lo ancho lo convertiría en una sola
     línea larga que compite con la firma de la cabecera; en tres líneas
     ocupa la página y se lee como una placa. */
  .apertura .display { max-width: 15ch; }
  /* :global porque el span lo inyecta set:html y el scoping de Astro no
     alcanza al marcado generado en el frontmatter. */
  .apertura .display :global(.junto) { white-space: nowrap; }

  .señales {
    list-style: none;
    margin: 6px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px 0;
  }
  .señales li:not(:last-child)::after {
    content: '·';
    color: var(--linea);
    margin-inline: 12px;
  }

  .acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 14px;
  }

  /* Un botón necesita 3:1 de borde para existir como control: por eso usa
     --borde (3,23:1) y no --linea (1,20:1), que solo vale como separador. */
  .boton {
    font-family: var(--mono);
    font-size: 12.5px;
    letter-spacing: 0.04em;
    text-decoration: none;
    padding: 11px 20px;
    border: 1px solid var(--borde);
    border-radius: 2px;
    color: var(--tinta);
    transition:
      background-color var(--t-micro) var(--ease-salida),
      color var(--t-micro) var(--ease-salida),
      transform var(--t-micro) var(--ease-salida);
  }
  .primario {
    background: var(--tinta);
    border-color: var(--tinta);
    color: var(--papel);
  }

  @media (hover: hover) and (pointer: fine) {
    .boton:hover { background: var(--tinta); color: var(--papel); border-color: var(--tinta); }
    .primario:hover { background: var(--acento); border-color: var(--acento); }
  }
  .boton:active { transform: scale(0.99); }

  @media (prefers-reduced-motion: reduce) {
    .boton { transition: none; }
  }
</style>
