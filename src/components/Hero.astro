---
import Icono from './Icono.astro';
import { textos } from '../i18n/textos';
import type { Idioma } from '../i18n/rutas';

interface Props { lang: Idioma }
const { lang } = Astro.props;
const t = textos[lang];
---

<section class="hero contenedor entrada" aria-label={t.hero.etiqueta}>
  <p class="kicker">
    <span class="punto" aria-hidden="true"></span>
    {t.hero.ubicacion}
  </p>

  <!-- El titular se parte donde se decide, no donde caiga: "full-stack"
       entero en la primera línea y la conjunción arrastrada a la segunda. -->
  <h1 class="display">{t.hero.linea1}<br /><em>{t.hero.linea2}</em></h1>

  <div class="acciones">
    <!-- El correo escrito vive solo en Contacto; aquí basta con llevar allí. -->
    <a href={`#${t.secciones.contacto.id}`} class="btn btn-borde">
      <Icono nombre="correo" tamano={16} />
      {t.hero.escribeme}
    </a>
  </div>
</section>

<style>
  .hero { padding-block: clamp(56px, 9vw, 104px) clamp(56px, 8vw, 96px); }

  .kicker {
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: var(--mono);
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--sec);
  }
  .punto {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--acento);
    flex-shrink: 0;
  }

  .display { margin-top: 28px; }


  .acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 40px;
  }

  @media (max-width: 680px) {
    .acciones .btn { width: 100%; justify-content: center; }
  }
</style>
