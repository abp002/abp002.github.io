---
import { marca, perfil, senales } from '../config/marca';
import Icono from './Icono.astro';
---

<section class="hero contenedor entrada" aria-label="Presentación">
  <p class="kicker">
    <span class="punto" aria-hidden="true"></span>
    {marca.nombre} — {perfil.ubicacion}
  </p>

  <!-- El titular se parte donde se decide, no donde caiga: "full-stack"
       entero en la primera línea y la conjunción arrastrada a la segunda. -->
  <h1 class="display">Desarrollador full-stack<br /><em>e IA aplicada.</em></h1>

  <p class="sub">
    ERP en producción, automatización con IA y producto propio. Ahora:
    desarrollador ERP en Win Innovación y Grado en Ciencia de Datos Aplicada
    en la UOC.
  </p>

  <div class="acciones">
    {perfil.cv && (
      <a href={perfil.cv} class="btn btn-primario" download>
        <Icono nombre="descarga" tamano={16} />
        Descargar CV (PDF)
      </a>
    )}
    <a href={`mailto:${marca.correo}`} class="btn btn-borde">
      <Icono nombre="correo" tamano={16} />
      {marca.correo}
    </a>
  </div>

  <dl class="senales">
    {senales.map((s) => (
      <div class="senal">
        <dt class="dato etiqueta">{s.etiqueta}</dt>
        <dd class="valor">{s.valor}</dd>
      </div>
    ))}
  </dl>
</section>

<style>
  .hero { padding-block: clamp(56px, 9vw, 104px) clamp(56px, 8vw, 96px); }

  .kicker {
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: var(--mono);
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--sec);
  }
  .punto {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--acento);
    flex-shrink: 0;
  }

  .display { margin-top: 28px; }

  .sub {
    margin-top: 28px;
    max-width: 620px;
    font-size: clamp(17px, 2.2vw, 19px);
    line-height: 1.6;
    color: var(--sec);
  }

  .acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 40px;
  }

  .senales {
    display: flex;
    flex-wrap: wrap;
    margin: 60px 0 0;
  }
  .senal {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding-inline: 32px;
    border-left: 1px solid var(--linea);
  }
  .senal:first-child { padding-left: 0; border-left: none; }
  .etiqueta { color: var(--mute); }
  .valor { margin: 0; font-size: 14.5px; font-weight: 500; }

  @media (max-width: 680px) {
    .acciones .btn { width: 100%; justify-content: center; }
    .senales { flex-direction: column; gap: 0; margin-top: 40px; }
    .senal {
      flex-direction: row;
      justify-content: space-between;
      align-items: baseline;
      padding: 12px 0;
      border-left: none;
      border-top: 1px solid var(--linea);
    }
  }
</style>
