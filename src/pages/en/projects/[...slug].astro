---
import FichaProyecto from '../../../vistas/FichaProyecto.astro';
import { cargarProyectos } from '../../../i18n/proyectos';

export async function getStaticPaths() {
  const proyectos = await cargarProyectos('en');
  return proyectos.map((p, i) => ({
    params: { slug: p.proyecto.id },
    props: { actual: p, siguiente: proyectos[(i + 1) % proyectos.length] },
  }));
}

const { actual, siguiente } = Astro.props;
---

<FichaProyecto lang="en" actual={actual} siguiente={siguiente} />
