---
import Base from '../../layouts/Base.astro';
import Seccion from '../../components/Seccion.astro';
import Pasos from '../../components/Pasos.astro';
import Icono from '../../components/Icono.astro';
import { cuaderno, nombreTipo } from '../../config/cuaderno';
import {
  blogActivo,
  entradas,
  fechaCorta,
  lineaDeEstado,
  minutos,
  numero,
  progreso,
} from '../../lib/cuaderno';

// Blog apagado: el índice redirige a la portada en vez de quedarse vacío.
if (!blogActivo) return Astro.redirect('/');

// En curso, de la más reciente a la más antigua; lo publicado, igual.
const todas = (await entradas()).reverse();
const enCurso = todas.filter(({ entrada }) => entrada.data.estado === 'en-curso');
const publicadas = todas.filter(({ entrada }) => entrada.data.estado !== 'en-curso');
// Sin nada en curso, «Publicado» pasa a ser la sección 01.
const nPublicado = enCurso.length > 0 ? '02' : '01';
---

<Base titulo={cuaderno.titulo} descripcion={cuaderno.descripcion}>
  <section class="cabecera contenedor">
    <div class="fila">
      <div class="rotulo">
        <p class="dato acento">Blog</p>
        <h1 class="titulo">{cuaderno.titulo}</h1>
        <p class="entradilla" set:html={cuaderno.entradilla} />
      </div>
      <aside class="normas" aria-labelledby="normas">
        <h2 id="normas" class="dato">Normas del cuaderno</h2>
        <ol>
          {cuaderno.normas.map((n, i) => (
            <li><span class="n">{numero(i + 1)}</span><span>{n}</span></li>
          ))}
        </ol>
      </aside>
    </div>
  </section>

  {todas.length === 0 && (
    <section class="bloque contenedor">
      <p class="vacio">{cuaderno.vacio}</p>
    </section>
  )}

  {enCurso.length > 0 && (
    <section class="bloque contenedor" aria-labelledby="en-curso">
      <Seccion numero="01" titulo="En curso" id="en-curso" />
      {enCurso.map(({ entrada, numero: n }) => {
        const d = entrada.data;
        return (
          <article class="tarjeta revela">
            <div class="texto">
              <p class="dato meta">
                <span class="acento">{nombreTipo[d.tipo]}</span>
                <span>N.º {numero(n)}</span>
                <span>Desde el {fechaCorta(d.fecha)}</span>
                {d.borrador && <span>Borrador</span>}
              </p>
              <h3 class="titulo-tarjeta">
                <a href={`/blog/${entrada.id}`} transition:name={`entrada-${entrada.id}`}>{d.titulo}</a>
              </h3>
              {d.subtitulo && <p class="subtitulo">{d.subtitulo}</p>}
              <div class="en-corto">
                <p class="dato">En corto</p>
                <p>{d.resumen}</p>
              </div>
              <div class="acciones">
                <a class="boton" href={`/blog/${entrada.id}`}>
                  Leer la entrada <Icono nombre="flecha" tamano={16} />
                </a>
                {d.protocolo?.url && (
                  <a class="boton boton-suave" href={d.protocolo.url} rel="noopener" target="_blank">
                    Protocolo {d.protocolo.version}
                  </a>
                )}
              </div>
            </div>
            <div class="estado">
              <p class="dato cabecera-estado">
                <span>Estado</span>
                <span class="acento">Paso {progreso(d).actual} de {progreso(d).total}</span>
              </p>
              <Pasos progreso={progreso(d)} forma="lista" />
            </div>
          </article>
        );
      })}
    </section>
  )}

  {publicadas.length > 0 && (
    <section class="bloque contenedor" aria-labelledby="publicado">
      <Seccion numero={nPublicado} titulo="Publicado" id="publicado" />
      <div class="lista">
        {publicadas.map(({ entrada, numero: n }) => {
          const d = entrada.data;
          const html = entrada.rendered?.html ?? '';
          return (
            <a href={`/blog/${entrada.id}`} class="fila enlace-fila revela">
              <span class="cuando">
                <span class="acento">N.º {numero(n)}</span>
                <span>{fechaCorta(d.fecha)}</span>
              </span>
              <span class="cuerpo">
                <span class="dato">
                  {nombreTipo[d.tipo]} · {minutos(html)} min{d.borrador && ' · Borrador'}
                </span>
                <span class="cabeza">
                  <span class="titulo-fila nombre" transition:name={`entrada-${entrada.id}`}>{d.titulo}</span>
                  <span class="flecha" aria-hidden="true"><Icono nombre="flecha" tamano={20} /></span>
                </span>
                <span class="resumen">{d.resumen}</span>
                <span class="dato linea-estado">
                  <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true">
                    <circle cx="5" cy="5" r="4" fill="none" stroke="currentColor" stroke-width="1.6" />
                    <circle cx="5" cy="5" r="1.6" fill="currentColor" />
                  </svg>
                  {lineaDeEstado(d)}
                </span>
              </span>
            </a>
          );
        })}
      </div>
    </section>
  )}
</Base>

<style>
  .cabecera { padding-top: clamp(48px, 7vw, 88px); }
  .fila {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 44px 72px;
    border-top: 1px solid var(--linea-fuerte);
    padding-top: 22px;
  }
  .rotulo {
    flex: 999 1 560px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .titulo {
    font-family: var(--serif);
    font-size: clamp(40px, 5vw, 68px);
    line-height: 1.02;
    letter-spacing: -0.028em;
  }
  .entradilla {
    max-width: 640px;
    font-family: var(--serif);
    font-size: clamp(18px, 1.5vw, 21px);
    line-height: 1.6;
    color: var(--prosa);
    text-wrap: pretty;
  }

  .normas { flex: 1 1 280px; min-width: 0; }
  .normas h2 { margin-bottom: 4px; }
  .normas ol { list-style: none; margin: 0; padding: 0; }
  .normas li {
    display: flex;
    gap: 16px;
    padding-block: 14px;
    border-bottom: 1px solid var(--linea);
    font-size: 15.5px;
    line-height: 1.5;
  }
  .normas .n,
  .cuando .acento {
    flex: 0 0 auto;
    font-family: var(--mono);
    font-size: 13px;
    line-height: 1.8;
    color: var(--acento);
  }

  .bloque { padding-top: clamp(56px, 7vw, 96px); }
  .vacio {
    padding-block: 26px;
    border-block: 1px solid var(--linea);
    font-size: 15px;
    color: var(--sec);
  }

  /* --- en curso --- */
  .tarjeta {
    margin-top: 26px;
    background: var(--superficie);
    border: 1px solid var(--linea);
    border-radius: 4px;
    padding: clamp(24px, 3.4vw, 48px);
    display: flex;
    flex-wrap: wrap;
    gap: 40px 72px;
  }
  .tarjeta + .tarjeta { margin-top: 20px; }
  .texto {
    flex: 999 1 440px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .meta { display: flex; flex-wrap: wrap; gap: 6px 14px; }
  .titulo-tarjeta {
    font-family: var(--serif);
    font-size: clamp(30px, 3.4vw, 46px);
    line-height: 1.06;
    letter-spacing: -0.022em;
  }
  .titulo-tarjeta a { color: var(--tinta); text-decoration: none; }
  .titulo-tarjeta a:hover {
    text-decoration: underline;
    text-decoration-color: var(--linea-fuerte);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }
  .subtitulo {
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(18px, 1.6vw, 21px);
    line-height: 1.4;
    color: var(--sec);
  }
  .en-corto {
    margin-top: 6px;
    padding-top: 18px;
    border-top: 1px solid var(--linea);
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .en-corto p:last-child {
    max-width: 560px;
    font-size: 16.5px;
    line-height: 1.6;
    color: var(--prosa);
    text-wrap: pretty;
  }
  .acciones { margin-top: 8px; display: flex; flex-wrap: wrap; gap: 12px; }
  .estado { flex: 1 1 300px; min-width: 0; }
  .cabecera-estado {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 12px;
  }

  /* --- publicado --- */
  .lista { margin-top: 8px; }
  .lista .fila {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 10px 28px;
    padding-block: 30px;
    border-top: none;
    border-bottom: 1px solid var(--linea);
  }
  .cuando {
    flex: 0 0 170px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-family: var(--mono);
    font-size: 13px;
    line-height: 1.6;
    font-variant-numeric: tabular-nums;
    color: var(--sec);
  }
  .cuerpo {
    flex: 999 1 460px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .cabeza { display: flex; align-items: flex-start; justify-content: space-between; gap: 20px; }
  .nombre {
    font-family: var(--serif);
    font-size: clamp(24px, 2.4vw, 31px);
    line-height: 1.15;
    letter-spacing: -0.015em;
    font-weight: 500;
  }
  .flecha { margin-top: 6px; }
  .resumen {
    max-width: 680px;
    font-size: 15.5px;
    line-height: 1.55;
    color: var(--sec);
    text-wrap: pretty;
  }
  .linea-estado { display: flex; align-items: center; gap: 9px; }
  .linea-estado svg { flex: 0 0 auto; color: var(--acento); }
</style>
