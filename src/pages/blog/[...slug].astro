---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icono from '../../components/Icono.astro';
import Pasos from '../../components/Pasos.astro';
import Predicciones from '../../components/Predicciones.astro';
import { marca } from '../../config/marca';
import { cuaderno, nombreTipo } from '../../config/cuaderno';
import {
  abiertas,
  blogActivo,
  entradas,
  fechaCorta,
  fechaLarga,
  lineaDeEstado,
  minutos,
  numero,
  partirEntrada,
  progreso,
  type EntradaNumerada,
} from '../../lib/cuaderno';

export async function getStaticPaths() {
  // Blog apagado: cero rutas en el build, aunque los .md sigan ahí.
  if (!blogActivo) return [];
  const lista = await entradas();
  const ids = new Set((await getCollection('blog')).map((e) => e.id));
  return lista.map((actual) => {
    const rel = actual.entrada.data.relacionado;
    // Un relacionado que no existe es una errata y para el build; uno que
    // existe pero no se publica (un borrador) simplemente no se enlaza.
    if (rel && !ids.has(rel))
      throw new Error(`«${actual.entrada.id}» enlaza como relacionada «${rel}», que no existe.`);
    const relacionada = lista.find((e) => e.entrada.id === rel) ?? null;
    return { params: { slug: actual.entrada.id }, props: { actual, relacionada } };
  });
}

interface Props {
  actual: EntradaNumerada;
  relacionada: EntradaNumerada | null;
}
const { actual, relacionada } = Astro.props;
const { entrada } = actual;
const d = entrada.data;
await render(entrada);
const partes = partirEntrada(entrada.rendered?.html ?? '');

const esInvestigacion = d.tipo === 'investigacion';
const prog = progreso(d);
const predicciones = d.predicciones ?? [];
const { cuantas: nAbiertas, primera } = abiertas(d);
const marcaPredicciones = partes.detalle.some((s) => s.trozos.length > 1);

// Lectura por capa: «en corto» es la prosa de antes del primer `##` más
// sus tres puntos y la cifra; «el detalle», todo lo demás menos las
// referencias.
const minCorto = minutos(
  partes.enCorto,
  ...(d.enCorto ?? []).map((p) => p.texto),
  d.cifra?.nota ?? '',
);
const minDetalle = minutos(
  ...partes.detalle.flatMap((s) => s.trozos),
  ...predicciones.map((p) => `${p.texto} ${p.refuta}`),
);
const hayEnCorto = partes.enCorto.trim() !== '' || d.enCorto || d.cifra;

// La ficha lateral: lo que depende del tipo y, detrás, las filas propias.
const actualizada =
  d.actualizado ?? [...prog.pasos].reverse().find((p) => p.hecho)?.hecho ?? d.fecha;
const ficha: { dato: string; valor: string }[] = esInvestigacion
  ? [
      ...(d.protocolo ? [{ dato: 'Protocolo', valor: d.protocolo.version }] : []),
      { dato: 'Iniciada', valor: fechaCorta(d.fecha) },
      { dato: 'Actualizada', valor: fechaCorta(actualizada) },
      ...d.ficha,
    ]
  : [
      { dato: 'Fecha', valor: fechaCorta(d.fecha) },
      { dato: 'Lectura', valor: `${minCorto} min en corto; ${minCorto + minDetalle} min entero` },
      ...d.ficha,
      ...(primera ? [{ dato: 'Revisión', valor: fechaCorta(primera) }] : []),
    ];
const estadoFicha = esInvestigacion
  ? lineaDeEstado(d).split(' · ').slice(0, 2).join(' · ')
  : lineaDeEstado(d).split(' · ')[0];

interface Accion { texto: string; href: string; fuera: boolean }
const acciones: Accion[] = (
  esInvestigacion
    ? [
        d.protocolo?.url ? { texto: 'Leer el protocolo', href: d.protocolo.url, fuera: true } : null,
        d.datos ? { texto: 'Preguntas, datos y código', href: d.datos, fuera: true } : null,
      ]
    : [
        nAbiertas > 0
          ? { texto: `Ver ${nAbiertas === 1 ? 'la predicción' : `las ${nAbiertas} predicciones`}`, href: '#predicciones', fuera: false }
          : null,
      ]
).filter((a): a is Accion => a !== null);

// «Cómo citar», sin punto tras un título que ya acaba en «?» o «!».
const conPunto = (s: string) => (/[.?!]$/.test(s) ? s : `${s}.`);
const cita = [
  `${cuaderno.autorCita} (${d.fecha.getUTCFullYear()}).`,
  conPunto(d.titulo),
  d.subtitulo ? conPunto(d.subtitulo) : null,
  `Cuaderno de investigación, ${nombreTipo[d.tipo].toLowerCase()} n.º ${actual.numero}, ${fechaLarga(d.fecha)}${d.protocolo ? `, protocolo ${d.protocolo.version}` : ''}.`,
  `${marca.dominio}/blog/${entrada.id}`,
]
  .filter(Boolean)
  .join(' ');

const responder = d.responder ?? cuaderno.responder[d.tipo];
---

<Base titulo={d.titulo} descripcion={d.resumen}>
  <article class="entrada">
    <section class="cabecera contenedor">
      <a href="/blog" class="volver dato">← Cuaderno</a>

      <div class="fila">
        <div class="rotulo">
          <p class="dato meta">
            <span class="acento">{nombreTipo[d.tipo]}</span>
            <span>N.º {numero(actual.numero)}</span>
            <span>{esInvestigacion ? `Desde el ${fechaCorta(d.fecha)}` : fechaCorta(d.fecha)}</span>
            {!esInvestigacion && <span>{minCorto + minDetalle} min</span>}
            {d.borrador && <span>Borrador</span>}
          </p>
          <h1 class="titulo" transition:name={`entrada-${entrada.id}`}>{d.titulo}</h1>
          {esInvestigacion
            ? d.subtitulo && <p class="subtitulo">{d.subtitulo}</p>
            : <p class="standfirst">{d.resumen}</p>}
          {acciones.length > 0 && (
            <div class="acciones">
              {acciones.map((a, i) => (
                <a
                  href={a.href}
                  class:list={['boton', { 'boton-suave': i > 0 }]}
                  rel={a.fuera ? 'noopener' : undefined}
                  target={a.fuera ? '_blank' : undefined}
                >
                  {a.texto}
                  <Icono nombre="flecha" tamano={16} />
                </a>
              ))}
            </div>
          )}
        </div>

        <aside class="ficha-lateral" aria-label={`Ficha de ${esInvestigacion ? 'la investigación' : 'el ensayo'}`}>
          <p class="dato">Ficha</p>
          <dl>
            <div>
              <dt class="dato">Estado</dt>
              <dd class="estado">
                <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true">
                  <circle cx="5" cy="5" r="4" fill="none" stroke="currentColor" stroke-width="1.6" />
                  <circle cx="5" cy="5" r="1.6" fill="currentColor" />
                </svg>
                <span>{estadoFicha}</span>
              </dd>
            </div>
            {ficha.map((f) => (
              <div>
                <dt class="dato">{f.dato}</dt>
                <dd>{f.valor}</dd>
              </div>
            ))}
          </dl>
        </aside>
      </div>
    </section>

    {hayEnCorto && (
      <section class="en-corto contenedor" aria-labelledby="en-corto">
        <div class="prosa-corta prosa">
          <h2 id="en-corto" class="rotulo-capa">En corto<span>{minCorto} min</span></h2>
          <Fragment set:html={partes.enCorto} />
        </div>
        {d.enCorto && (
          <ol class="puntos">
            {d.enCorto.map((p, i) => (
              <li>
                <span class="dato acento">{numero(i + 1)} · {p.rotulo}</span>
                <span>{p.texto}</span>
              </li>
            ))}
          </ol>
        )}
        {d.cifra && (
          <div class="cifra">
            <div class="valores-cifra">
              <p class="dato">{d.cifra.rotulo}</p>
              <div class="valores">
                {d.cifra.valores.map((v, i) => (
                  <>
                    {i > 0 && (
                      <svg class="hacia" width="28" height="28" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                    )}
                    <div class:list={['valor', { ultimo: i === d.cifra!.valores.length - 1 && i > 0 }]}>
                      <span class="numero">{v.valor}</span>
                      <span class="dato">{v.que}</span>
                    </div>
                  </>
                ))}
              </div>
            </div>
            <p class="nota-cifra">{d.cifra.nota}</p>
          </div>
        )}
      </section>
    )}

    {esInvestigacion && (
      <section class="estado-entrada contenedor" aria-labelledby="estado">
        <div class="cabecera-estado">
          <h2 id="estado">Estado</h2>
          <p class="dato acento">
            {prog.actual > prog.total
              ? 'Completada'
              : `Paso ${prog.actual} de ${prog.total} · ${prog.pasos[prog.actual - 1].titulo}`}
          </p>
        </div>
        <Pasos progreso={prog} forma="linea" abandonada={d.estado === 'abandonada'} />
      </section>
    )}

    {(partes.detalle.length > 0 || predicciones.length > 0) && (
      <section class="detalle contenedor" aria-labelledby="detalle">
        <header class="cabecera-detalle">
          <h2 id="detalle" class="rotulo-capa">El detalle<span>{minDetalle} min</span></h2>
          <p class="subtitulo-detalle">{cuaderno.detalle[d.tipo]}</p>
        </header>

        {partes.detalle.map((s) => (
          <section class="parte prosa" aria-labelledby={s.id || undefined}>
            <h3 id={s.id || undefined}>
              {s.numero && <span class="num">{s.numero}</span>}
              <span set:html={s.titulo} />
            </h3>
            <Fragment set:html={s.trozos[0]} />
            {s.trozos.length > 1 && (
              <>
                <Predicciones predicciones={predicciones} linea={lineaDeEstado(d)} />
                <Fragment set:html={s.trozos.slice(1).join('')} />
              </>
            )}
          </section>
        ))}

        {predicciones.length > 0 && !marcaPredicciones && (
          <section class="parte" aria-label="Predicciones">
            <Predicciones predicciones={predicciones} linea={lineaDeEstado(d)} />
          </section>
        )}
      </section>
    )}

    <section class="cierre contenedor">
      {partes.referencias && (
        <section class="referencias prosa" aria-labelledby="referencias">
          <h2 id="referencias">Referencias</h2>
          <Fragment set:html={partes.referencias} />
        </section>
      )}

      <div class="fila-cierre">
        <div class="principal">
          {d.cambios.length > 0 && (
            <section aria-labelledby="cambios">
              <h2 id="cambios">Registro de cambios</h2>
              <ol class="cambios">
                {d.cambios.map((c) => (
                  <li>
                    <span class="dato">{fechaCorta(c.fecha)}</span>
                    {c.version && <span class="dato acento">{c.version}</span>}
                    <span class="texto-cambio">{c.texto}</span>
                  </li>
                ))}
              </ol>
            </section>
          )}
          <section aria-labelledby="citar">
            <h2 id="citar">Cómo citar</h2>
            <p class="cita-ref">{cita}</p>
          </section>
        </div>

        <div class="lateral">
          <div class="responder">
            <p class="dato acento">Responder</p>
            <p class="pregunta">{responder.pregunta}</p>
            <p class="texto-responder">{responder.texto}</p>
            <a class="boton boton-suave correo" href={`mailto:${marca.correo}?subject=${encodeURIComponent(d.titulo)}`}>
              <Icono nombre="correo" tamano={16} />
              {/* Si no cabe, que corte tras la arroba y no a mitad del dominio. */}
              <span>{marca.correo.split('@')[0]}@<wbr />{marca.correo.split('@')[1]}</span>
            </a>
          </div>
          {relacionada && (
            <a class="relacionada enlace-fila" href={`/blog/${relacionada.entrada.id}`}>
              <span class="dato">Relacionado · {nombreTipo[relacionada.entrada.data.tipo]}</span>
              <span class="titulo-fila nombre">{relacionada.entrada.data.titulo}</span>
              <span class="resumen">{relacionada.entrada.data.resumen}</span>
            </a>
          )}
        </div>
      </div>
    </section>
  </article>
</Base>

<style>
  .entrada { counter-reset: figura; }

  /* --- cabecera --- */
  .cabecera { padding-top: clamp(40px, 6vw, 72px); }
  .volver {
    display: inline-flex;
    padding-block: 12px;
    margin-block: -12px;
    text-decoration: none;
    transition: color var(--t-micro) var(--ease-salida);
  }
  .volver:hover { color: var(--tinta); }

  .fila {
    margin-top: 28px;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 40px 56px;
  }
  .rotulo {
    flex: 999 1 560px;
    min-width: 0;
    max-width: 680px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .meta { display: flex; flex-wrap: wrap; gap: 6px 14px; font-size: 12px; letter-spacing: 0.1em; }
  .titulo {
    font-family: var(--serif);
    font-size: clamp(40px, 5.4vw, 72px);
    line-height: 1.02;
    letter-spacing: -0.03em;
  }
  .subtitulo {
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(20px, 2vw, 26px);
    line-height: 1.35;
    color: var(--sec);
    text-wrap: pretty;
  }
  .standfirst {
    font-family: var(--serif);
    font-size: clamp(19px, 1.8vw, 22px);
    line-height: 1.55;
    color: var(--prosa);
    text-wrap: pretty;
  }
  .acciones { margin-top: 10px; display: flex; flex-wrap: wrap; gap: 12px; }

  .ficha-lateral {
    flex: 1 1 280px;
    min-width: 0;
    background: var(--superficie);
    border: 1px solid var(--linea);
    border-radius: 4px;
    padding: 20px 22px 8px;
  }
  .ficha-lateral > .dato { margin-bottom: 8px; }
  dl { margin: 0; }
  dl > div {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 14px;
    padding-block: 12px;
    border-top: 1px solid var(--linea);
  }
  dt { flex: 0 0 96px; padding-top: 2px; }
  dd {
    flex: 1 1 120px;
    min-width: 0;
    margin: 0;
    font-size: 15px;
    line-height: 1.45;
    color: var(--tinta);
  }
  .estado { display: flex; align-items: baseline; gap: 8px; }
  .estado svg { flex: 0 0 auto; color: var(--acento); }

  /* El rótulo de cada capa: mono en óxido con sus minutos de lectura. */
  .rotulo-capa {
    display: flex;
    gap: 12px;
    font-family: var(--mono);
    font-size: 11px;
    line-height: 1.6;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    font-weight: 400;
    color: var(--acento);
  }
  .rotulo-capa span { color: var(--sec); }

  /* --- en corto --- */
  .en-corto { padding-top: clamp(56px, 7vw, 88px); }
  .prosa-corta { max-width: 680px; display: flex; flex-direction: column; gap: 22px; }
  .prosa-corta :global(p) {
    font-family: var(--serif);
    font-size: clamp(20px, 1.7vw, 23px);
    line-height: 1.6;
    color: var(--prosa);
    text-wrap: pretty;
  }
  .puntos {
    list-style: none;
    margin: 40px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0 40px;
    border-top: 2px solid var(--tinta);
  }
  .puntos li {
    flex: 1 1 260px;
    min-width: 0;
    padding-top: 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 17px;
    line-height: 1.55;
    color: var(--tinta);
    text-wrap: pretty;
  }
  .puntos .dato { font-size: 12px; letter-spacing: 0.1em; }

  .cifra {
    margin-top: 40px;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 24px 56px;
    border-top: 1px solid var(--linea-fuerte);
    padding-top: 22px;
  }
  .valores-cifra { flex: 0 1 auto; display: flex; flex-direction: column; gap: 10px; }
  .valores { display: flex; flex-wrap: wrap; align-items: flex-end; gap: 12px 24px; }
  .valor { display: flex; flex-direction: column; gap: 6px; }
  .valor .numero {
    font-family: var(--mono);
    font-size: clamp(44px, 4.6vw, 64px);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
    color: var(--tinta);
  }
  .valor.ultimo .numero { color: var(--acento); }
  .hacia { color: var(--linea-fuerte); margin-bottom: 30px; }
  .nota-cifra {
    flex: 1 1 300px;
    min-width: 0;
    max-width: 520px;
    font-size: 16px;
    line-height: 1.6;
    color: var(--prosa);
    text-wrap: pretty;
  }

  /* --- estado --- */
  .estado-entrada { padding-top: clamp(56px, 7vw, 88px); }
  .cabecera-estado {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 6px 24px;
    border-top: 1px solid var(--linea-fuerte);
    padding-top: 18px;
    margin-bottom: 26px;
  }
  .cabecera-estado h2,
  .cierre h2 {
    font-family: var(--serif);
    font-size: 24px;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  /* --- el detalle --- */
  .detalle { padding-top: clamp(72px, 9vw, 120px); }
  .cabecera-detalle {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 24px;
    border-top: 2px solid var(--tinta);
    padding-top: 20px;
  }
  .subtitulo-detalle {
    font-family: var(--serif);
    font-style: italic;
    font-size: 20px;
    line-height: 1.4;
    color: var(--sec);
  }

  /* Como en las fichas de proyecto: una columna de lectura de 680 px y, a
     su derecha, la nota al margen del párrafo que la precede. Figuras,
     tablas y predicciones usan el ancho entero. */
  .parte {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 220px;
    column-gap: 56px;
    padding-top: 52px;
  }
  .parte > :global(*) { grid-column: 1 / -1; max-width: 680px; }
  .parte > :global(* + *) { margin-top: 22px; }
  .parte > :global(p:has(+ aside.nota)),
  .parte > :global(ul:has(+ aside.nota)),
  .parte > :global(ol:has(+ aside.nota)) { grid-column: 1; }
  .parte > :global(aside.nota) { grid-column: 2; align-self: start; }
  .parte > :global(table),
  .parte > :global(figure) { max-width: none; }
  .parte > :global(.predicciones) { max-width: none; margin-top: 36px; }
  @media (max-width: 880px) {
    .parte { display: block; }
  }

  .parte h3 {
    display: flex;
    align-items: baseline;
    gap: 14px;
    font-family: var(--serif);
    font-size: clamp(25px, 3.2vw, 30px);
    line-height: 1.2;
    letter-spacing: -0.012em;
  }
  .parte .num {
    font-family: var(--mono);
    font-size: 14px;
    font-weight: 400;
    letter-spacing: 0;
    color: var(--acento);
  }
  .parte :global(h4) {
    font-family: var(--sans);
    font-size: 16px;
    font-weight: 600;
    color: var(--tinta);
  }

  /* Solo los hijos directos: así la prosa no se cuela en las predicciones
     ni en las notas al margen, que llevan su propia letra. */
  .parte > :global(p),
  .parte > :global(ul),
  .parte > :global(ol) {
    font-family: var(--serif);
    font-size: 19px;
    line-height: 1.78;
    color: var(--prosa);
    text-wrap: pretty;
  }
  .parte :global(em) { font-style: italic; }

  .parte > :global(ol) {
    list-style: none;
    padding: 0;
    border-bottom: 1px solid var(--linea);
    counter-reset: punto;
  }
  .parte > :global(ol > li) {
    position: relative;
    padding: 16px 0 16px 40px;
    border-top: 1px solid var(--linea);
    line-height: 1.6;
    counter-increment: punto;
  }
  .parte > :global(ol > li::before) {
    content: counter(punto);
    position: absolute;
    left: 0;
    top: 16px;
    font-family: var(--mono);
    font-size: 14px;
    font-weight: 500;
    line-height: 2;
    color: var(--acento);
  }
  .parte > :global(ul) {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .parte > :global(ul > li) { position: relative; padding-left: 28px; line-height: 1.6; }
  .parte > :global(ul > li::before) {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--linea-fuerte);
  }

  .parte :global(aside.nota) {
    border-top: 1px solid var(--linea);
    padding-top: 12px;
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--sec);
  }
  .parte :global(aside.nota p) {
    font-family: var(--sans);
    font-size: inherit;
    line-height: inherit;
    color: inherit;
  }
  .parte :global(aside.nota p + p) { margin-top: 10px; }
  .parte :global(aside.nota strong:first-child) {
    display: block;
    margin-bottom: 6px;
    font-family: var(--mono);
    font-size: 11px;
    line-height: 1.6;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    font-weight: 400;
    color: var(--acento);
  }

  /* Una cita sin rótulo en negrita es la frase que se queda. */
