---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Seccion from '../components/Seccion.astro';
import StackLogos from '../components/StackLogos.astro';
import Trayectoria from '../components/Trayectoria.astro';
import TarjetaProyecto from '../components/TarjetaProyecto.astro';
import BlogLista from '../components/BlogLista.astro';
import Contacto from '../components/Contacto.astro';
import { perfil, contacto, mostrarBlog } from '../config/marca';

// La portada enseña cuatro tarjetas: las cuatro primeras por `orden`.
// Bythos (orden 5) queda accesible por URL; una parrilla 2×2 completa
// vale más que una de cinco con un hueco.
const proyectos = (await getCollection('proyectos'))
  .sort((a, b) => a.data.orden - b.data.orden)
  .slice(0, 4);

const posts = mostrarBlog
  ? (await getCollection('blog', ({ data }) => !data.ejemplo))
      .sort((a, b) => b.data.fecha.getTime() - a.data.fecha.getTime())
      .slice(0, 3)
  : [];

// Numeración corrida: si el blog se apaga, contacto pasa de 06 a 05
// sin dejar un salto en el expediente.
const nContacto = mostrarBlog ? '06' : '05';

// GitHub y LinkedIn salen de `contacto` para no duplicar las URL.
const red = (etiqueta: string) => contacto.find((c) => c.etiqueta === etiqueta);

const datos: { etiqueta: string; valor: string | null; href?: string }[] = [
  { etiqueta: 'GitHub', valor: red('GitHub')?.valor ?? null, href: red('GitHub')?.href },
  { etiqueta: 'LinkedIn', valor: red('LinkedIn')?.valor ?? null, href: red('LinkedIn')?.href },
  { etiqueta: 'Idiomas', valor: perfil.idiomas },
  { etiqueta: 'Movilidad', valor: perfil.movilidad },
].filter((d) => d.valor !== null);
---

<Base>
  <Hero />

  <section class="bloque contenedor" aria-label="Sobre mí">
    <Seccion numero="01" titulo="Sobre mí" id="sobre-mi" />
    <div class="sobre">
      <div class="cuerpo prosa-serif revela">
        <p>
          En Win Innovación desarrollo y lidero proyectos de software de
          gestión empresarial, incluidos contabilidad y cumplimiento fiscal.
        </p>
        <p>
          También desarrollo software con inteligencia artificial integrada:
          sistemas RAG (generación aumentada por recuperación), que responden a
          partir de documentación propia, y servidores MCP (Model Context
          Protocol) a medida, que conectan los modelos con herramientas y datos
          reales.
        </p>
        <p>
          Estudio el Grado en Ciencia de Datos Aplicada en la UOC. Mi objetivo es
          unir las tres piezas: el desarrollo, la IA y los datos.
        </p>
      </div>

      <dl class="fichas revela-tarde">
        {datos.map((d) => (
          <div class="ficha-dato">
            <dt class="dato">{d.etiqueta}</dt>
            <dd class="valor">
              {d.href ? <a href={d.href} rel="me noopener" target="_blank">{d.valor}</a> : d.valor}
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="bloque contenedor" aria-label="Stack">
    <Seccion numero="02" titulo="Stack" id="stack" />
    <StackLogos />
  </section>

  <section class="bloque contenedor" aria-label="Trayectoria">
    <Seccion numero="03" titulo="Trayectoria" id="trayectoria" />
    <Trayectoria />
  </section>

  <section class="bloque contenedor" aria-label="Proyectos">
    <Seccion numero="04" titulo="Proyectos" id="proyectos" />
    <div class="parrilla-proyectos">
      {proyectos.map((p) => <TarjetaProyecto proyecto={p} />)}
    </div>
  </section>

  {mostrarBlog && (
    <section class="bloque contenedor" aria-label="Blog">
      <Seccion numero="05" titulo="Blog" id="blog" />
      <BlogLista posts={posts} />
    </section>
  )}

  <section class="bloque contenedor" aria-label="Contacto">
    <Seccion numero={nContacto} titulo="Contacto" id="contacto" />
    <Contacto />
  </section>
</Base>

<style>
  .bloque { padding-block: 0 var(--aire); }

  .sobre {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    gap: clamp(36px, 6vw, 80px);
    margin-top: 40px;
    align-items: start;
  }
  @media (max-width: 860px) {
    .sobre { grid-template-columns: 1fr; gap: 34px; }
  }

  .cuerpo {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .fichas { display: flex; flex-direction: column; margin: 0; }
  .ficha-dato {
    display: grid;
    grid-template-columns: 110px minmax(0, 1fr);
    gap: 16px;
    padding-block: 14px;
    border-top: 1px solid var(--linea);
  }
  .ficha-dato:last-child { border-bottom: 1px solid var(--linea); }
  .ficha-dato .dato { color: var(--mute); }
  .valor { margin: 0; font-size: 14.5px; font-weight: 500; }
  .valor a { color: inherit; text-decoration: underline; text-decoration-color: var(--borde, currentColor); text-underline-offset: 3px; }
  .valor a:hover { text-decoration-color: currentColor; }

  .parrilla-proyectos {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 28px;
    margin-top: 40px;
  }
  @media (max-width: 780px) {
    .parrilla-proyectos { grid-template-columns: 1fr; gap: 16px; }
  }
</style>
