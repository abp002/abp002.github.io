---
// El "sobre mí" es ahora la apertura de la portada (la sección con ancla
// desapareció con el cuaderno, 11-oct). Esta ruta se mantiene como
// redirección en lugar de borrarse: si el enlace se hubiera compartido en
// algún sitio, un 404 es peor que un salto.
const destino = '/';
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${destino}`} />
    <link rel="canonical" href={destino} />
    <meta name="robots" content="noindex" />
    <title>Sobre — Alejandro Borrego</title>
  </head>
  <body>
    <p>Esta página se ha movido. <a href={destino}>Continuar</a>.</p>
  </body>
</html>
