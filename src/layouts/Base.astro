---
import { ClientRouter } from 'astro:transitions';
import { marca, paleta, mostrarBlog } from '../config/marca';
import Icono from '../components/Icono.astro';
import Bandera from '../components/Bandera.astro';
import { textos } from '../i18n/textos';
import { idiomaDe, rutaEquivalente, rutaPortada, rutaProyectos } from '../i18n/rutas';

// Newsreader con eje óptico (opsz 6–72): a 68 px coge el corte de titular y
// a 19 px el de texto, que es como se ve en el lienzo. Pesa el doble que la
// de solo peso (132 + 144 KB en latin), y la cursiva solo baja si se usa.
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource-variable/newsreader/opsz-italic.css';
import '@fontsource-variable/instrument-sans';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';

interface Props {
  titulo?: string;
  descripcion?: string;
}
// El idioma lo dice la URL (/en/… o no), así ninguna página puede pintar
// la barra en un idioma y el contenido en otro.
const lang = idiomaDe(Astro.url.pathname);
const t = textos[lang];
const { titulo, descripcion = t.meta.subtitulo } = Astro.props;
const tituloCompleto = titulo ? `${titulo} — ${marca.nombre}` : marca.nombre;

// El blog solo existe en español: en inglés no ocupa barra.
const anclas = marca.anclas
  .filter((a) => a !== 'blog' || (mostrarBlog && lang === 'es'))
  .map((a) => ({
    texto: t.nav[a],
    href: a === 'proyectos' ? rutaProyectos(lang) : '/blog',
  }));
// La sección actual se marca también dentro de sus fichas (/proyectos/sello).
const ruta = Astro.url.pathname.replace(/\/$/, '');
const actual = (href: string) => ruta === href || ruta.startsWith(`${href}/`);

const site = Astro.site ?? new URL('https://alejandroborrego.dev');
const versiones = {
  es: rutaEquivalente(Astro.url.pathname, 'es'),
  en: rutaEquivalente(Astro.url.pathname, 'en'),
};
const alternativa = versiones[lang === 'es' ? 'en' : 'es'];
const github = 'https://github.com/abp002';
const linkedin = 'https://www.linkedin.com/in/aborregop';
---

<html lang={lang} data-paleta={paleta ?? undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" hreflang="es" href={new URL(versiones.es, site).href} />
    <link rel="alternate" hreflang="en" href={new URL(versiones.en, site).href} />
    <link rel="alternate" hreflang="x-default" href={new URL(versiones.es, site).href} />
    {lang === 'es' && (
      <script is:inline define:vars={{ destino: alternativa }}>
        // Primera visita en español desde un navegador que no lee español:
        // a la misma página en inglés. Solo si nadie ha elegido idioma a mano
        // (las banderas lo guardan) y nunca a un buscador, que tiene que ver
        // las dos versiones. Es el idioma del navegador y no la IP: un
        // reclutador español en Londres lee español.
        try {
          var elegido = localStorage.getItem('idioma');
          var bot = /bot|crawl|spider|slurp|lighthouse|headless/i.test(navigator.userAgent);
          var lenguas = navigator.languages && navigator.languages.length
            ? navigator.languages
            : [navigator.language || ''];
          var leeEspanol = lenguas.some(function (l) { return /^es\b/i.test(l); });
          if (!elegido && !bot && !leeEspanol) location.replace(destino + location.hash);
        } catch (e) {}
      </script>
    )}
    <ClientRouter />
  </head>

  <body>
    <a class="saltar" href="#principal">{t.base.saltar}</a>

    <header class="nav">
      <div class="contenedor barra">
        <a href={rutaPortada(lang)} class="firma" aria-label={marca.firma}>
          <span class="firma-larga" aria-hidden="true">{marca.firma}</span>
          <span class="firma-corta" aria-hidden="true">{marca.iniciales}</span>
        </a>
        <nav aria-label={t.base.navPrincipal} class="anclas">
          {anclas.map((a) => (
            <a href={a.href} class="ancla" aria-current={actual(a.href) ? 'page' : undefined}>{a.texto}</a>
          ))}
        </nav>
        <div class="controles plegados">
          <details class="desplegable" name="barra">
            <summary class="disparador" aria-label={t.base.grupoIdioma}>
              <Bandera pais={lang === 'es' ? 'es' : 'gb'} />
              <span class="chevron"><Icono nombre="chevron" tamano={14} /></span>
            </summary>
            <div class="panel">
              <a
                href={alternativa}
                hreflang={lang === 'es' ? 'en' : 'es'}
                lang={lang === 'es' ? 'en' : 'es'}
                class="opcion"
                data-idioma={lang === 'es' ? 'en' : 'es'}
              >
                <Bandera pais={lang === 'es' ? 'gb' : 'es'} />
                {lang === 'es' ? 'English' : 'Español'}
              </a>
            </div>
          </details>
          <details class="desplegable" name="barra">
            <summary class="disparador" aria-label={t.base.perfiles}>
              <Icono nombre="arroba" />
              <span class="chevron"><Icono nombre="chevron" tamano={14} /></span>
            </summary>
            <div class="panel">
              <a href={github} class="opcion"><Icono nombre="github" /> GitHub</a>
              <a href={linkedin} class="opcion"><Icono nombre="linkedin" /> LinkedIn</a>
              <a href={`mailto:${marca.correo}`} class="opcion" data-copiar={marca.correo} data-aviso={t.base.copiado}>
                <Icono nombre="correo" /> {marca.correo}
              </a>
            </div>
          </details>
        </div>
        <div class="controles en-linea">
          <div class="idioma" role="group" aria-label={t.base.grupoIdioma}>
            <a
              href={versiones.es}
              hreflang="es"
              lang="es"
              class="lang"
              data-idioma="es"
              aria-label="Español"
              aria-current={lang === 'es' ? 'true' : undefined}
            >
              <Bandera pais="es" />
            </a>
            <a
              href={versiones.en}
              hreflang="en"
              lang="en"
              class="lang"
              data-idioma="en"
              aria-label="English"
              aria-current={lang === 'en' ? 'true' : undefined}
            >
              <Bandera pais="gb" />
            </a>
          </div>
          <span class="separador" aria-hidden="true"></span>
          <div class="redes">
            <a href={github} aria-label="GitHub" class="red"><Icono nombre="github" /></a>
            <a href={linkedin} aria-label="LinkedIn" class="red"><Icono nombre="linkedin" /></a>
            <a href={`mailto:${marca.correo}`} aria-label={t.base.correo} class="red" data-copiar={marca.correo} data-aviso={t.base.copiado}><Icono nombre="correo" /></a>
          </div>
        </div>
      </div>
    </header>

    <main id="principal">
      <slot />
    </main>

    <footer class="pie">
      <div class="contenedor pie-fila">
        <span class="dato">© {new Date().getFullYear()} {marca.nombre}</span>
        <span class="dato">{marca.dominio}</span>
      </div>
    </footer>

    <script>
      // Elegir bandera es elegir idioma para siempre: la detección del
      // navegador deja de actuar. En captura, antes de que el router de
      // transiciones se lleve el clic.
      document.addEventListener(
        'click',
        (event) => {
          const enlace = (event.target as Element | null)?.closest<HTMLElement>('[data-idioma]');
          if (!enlace) return;
          try {
            localStorage.setItem('idioma', enlace.dataset.idioma ?? '');
          } catch {}
        },
        true,
      );

      // mailto: no hace nada si el navegador no tiene cliente de correo
      // (lo normal con Gmail web), así que el clic además copia la
      // dirección y lo avisa. El enlace sigue abriendo el cliente si lo hay.
      document.addEventListener('click', (event) => {
        const enlace = (event.target as Element | null)?.closest<HTMLElement>('[data-copiar]');
        if (!enlace) return;
        navigator.clipboard?.writeText(enlace.dataset.copiar ?? '').then(() => {
          enlace.dataset.copiado = '';
          setTimeout(() => delete enlace.dataset.copiado, 1600);
        }, () => {});
      });

      // Los desplegables de la barra en móvil son <details>: abren sin JS.
      // Esto solo los cierra al tocar fuera o con Escape.
      const cerrar = (salvo?: Element | null) =>
        document.querySelectorAll<HTMLDetailsElement>('details.desplegable[open]').forEach((d) => {
          if (!salvo || !d.contains(salvo)) d.open = false;
        });
      document.addEventListener('click', (event) => cerrar(event.target as Element | null));
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') cerrar();
      });

      // Volver debe ir más rápido que entrar. Astro dice en qué dirección
      // navega antes de preparar la transición; el CSS lee este atributo.
      document.addEventListener('astro:before-preparation', (event) => {
        const e = event as CustomEvent & { direction?: string };
        document.documentElement.dataset.nav =
          e.direction === 'back' ? 'atras' : 'adelante';
      });
    </script>
  </body>
</html>

<style>
  .saltar {
    position: absolute;
    left: -9999px;
    top: 12px;
    z-index: 10;
    background: var(--tinta);
    color: var(--fondo);
    padding: 10px 16px;
    border-radius: 3px;
    font-size: 14px;
  }
  .saltar:focus-visible { left: 12px; }

  .nav { border-bottom: 1px solid var(--linea); }
  .barra {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 22px;
    padding-block: 20px;
  }

  .firma {
    font-family: var(--serif);
    font-size: 19px;
    font-weight: 600;
    letter-spacing: -0.01em;
    text-decoration: none;
    white-space: nowrap;
  }
  .firma-corta { display: none; }

  .anclas {
    display: flex;
    align-items: center;
    gap: 24px;
  }
  .ancla {
    padding-block: 12px;
    font-size: 13.5px;
    font-weight: 500;
    color: var(--sec);
    text-decoration: none;
    transition: color var(--t-micro) var(--ease-salida);
  }
  .ancla:hover { color: var(--tinta); }
  .ancla[aria-current='page'] { color: var(--tinta); }

  /* El idioma queda a la izquierda del separador y los perfiles a la
     derecha: la raya vertical separa "ajustar la página" de "escribirme". */
  .controles { display: flex; align-items: center; gap: 20px; }
  .redes { display: flex; align-items: center; gap: 18px; }
  .separador { width: 1px; height: 18px; background: var(--linea-fuerte); opacity: 0.6; }

  /* Enlaces con hreflang a la misma página en el otro idioma; el activo
     lleva aria-current. */
  .idioma { display: flex; align-items: center; gap: 7px; }
  .lang {
    display: flex;
    border-radius: 2px;
    cursor: pointer;
    /* El estado lo marca el color de la bandera, no un fondo: la activa a
       todo color y la otra en gris. Así el único color ajeno a la paleta
       que entra en la barra es el del idioma que está puesto. */
    filter: grayscale(1);
    opacity: 0.5;
    transition: filter var(--t-micro) var(--ease-salida),
                opacity var(--t-micro) var(--ease-salida);
  }
  .lang:hover { filter: grayscale(0); opacity: 1; }
  .lang[aria-current='true'] { filter: none; opacity: 1; }
  /* El padding agranda el área de toque a 38 px sin mover el dibujo. */
  .red {
    display: flex;
    padding: 10px;
    margin: -10px;
    color: var(--sec);
    transition: color var(--t-micro) var(--ease-salida);
  }
  .red:hover { color: var(--tinta); }

  /* En móvil idioma y perfiles se pliegan en dos desplegables (bandera
     actual y arroba) para que Proyectos quepa en la misma fila que la
     firma: una sola línea de barra, sin hamburguesa. */
  .plegados { display: none; gap: 6px; }
  .desplegable { position: relative; }
  .disparador {
    display: flex;
    align-items: center;
    gap: 3px;
    padding: 10px 6px;
    list-style: none;
    cursor: pointer;
    color: var(--sec);
    border-radius: 3px;
    transition: color var(--t-micro) var(--ease-salida);
  }
  .disparador::-webkit-details-marker { display: none; }
  .disparador:hover, [open] > .disparador { color: var(--tinta); }
  .chevron { display: flex; transition: transform var(--t-micro) var(--ease-salida); }
  [open] .chevron { transform: rotate(180deg); }

  .panel {
    position: absolute;
    right: 0;
    top: calc(100% + 6px);
    z-index: 20;
    display: flex;
    flex-direction: column;
    min-width: 168px;
    padding: 6px;
    background: var(--superficie);
    border: 1px solid var(--borde);
    border-radius: 4px;
    box-shadow: 0 8px 24px -12px color-mix(in srgb, var(--tinta) 30%, transparent);
    transform-origin: top right;
    animation: abrir var(--t-micro) var(--ease-salida);
  }
  @keyframes abrir {
    from { opacity: 0; transform: translateY(-4px) scale(0.98); }
  }
  @media (prefers-reduced-motion: reduce) {
    .panel { animation: none; }
  }
  .opcion {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    font-size: 13.5px;
    color: var(--sec);
    text-decoration: none;
    white-space: nowrap;
    border-radius: 3px;
  }
  .opcion:hover { color: var(--tinta); background: var(--relleno); }

  /* Aviso de "copiado" al pulsar el correo, encima o al lado del enlace. */
  [data-copiar] { position: relative; }
  [data-copiar][data-copiado]::after {
    content: attr(data-aviso);
    position: absolute;
    right: 0;
    top: calc(100% + 4px);
    padding: 4px 8px;
    font-family: var(--mono);
    font-size: 11px;
    color: var(--fondo);
    background: var(--tinta);
    border-radius: 3px;
    white-space: nowrap;
    pointer-events: none;
  }
  .opcion[data-copiado]::after { top: 50%; right: 8px; transform: translateY(-50%); }

  @media (max-width: 780px) {
    .barra { gap: 14px; }
    .anclas { margin-left: auto; }
    .en-linea { display: none; }
    .plegados { display: flex; }
  }

  /* Por debajo de 360 px la firma pasa a iniciales. El nombre completo
     sigue siendo el nombre accesible del enlace vía aria-label. */
  @media (max-width: 360px) {
    .firma-larga { display: none; }
    .firma-corta { display: inline; }
  }

  .pie { border-top: 1px solid var(--linea); margin-top: var(--aire); }
  .pie-fila {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px;
    padding-block: 26px 32px;
  }
</style>
